# --- Database ---
DATABASE_URL="postgresql://stardust:stardust@127.0.0.1:5433/stardust"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_REFRESH_SECRET="change-me-dev-only-too"

# --- Server ---
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Publicly reachable base URL of THIS api server - used to build OAuth
# redirect_uri values (must exactly match what's registered with each
# provider). In dev this is your local API URL; in production it's your
# real API domain.
API_PUBLIC_URL="http://localhost:4000"

# --- OAuth sign-in (Google / Facebook) ---
# Both are optional - omitted providers simply won't be offered on the
# login/signup pages (the button redirects to an "unavailable" message
# instead of crashing). See docs/milestones/04-oauth.md for exact setup
# steps (redirect URIs to register, required scopes, etc).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: {API_PUBLIC_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook for Developers -> your app -> Facebook Login -> Settings
# Valid OAuth Redirect URI: {API_PUBLIC_URL}/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Astrology provider selection ---
# Registered provider ids: swiss-ephemeris (default, self-hosted, no key needed)
ASTROLOGY_PROVIDER_DEFAULT="swiss-ephemeris"
# Optional per-country override, JSON map of ISO country code -> provider id.
# Populate once scripts/compare-providers.ts has validated accuracy per region.
# ASTROLOGY_PROVIDER_BY_COUNTRY={"US":"swiss-ephemeris"}

# --- Third-party astrology providers (not required for swiss-ephemeris) ---
# Sign up at https://api.prokerala.com -> Free Plan -> create an API Client
# to get these two values. Optional - omitted means only swiss-ephemeris is
# registered (providerRegistry.ts skips it silently, same pattern as OAuth).
# Note: sandbox/free-tier keys only accept January 1st as the date (any
# year, any time) - see docs/milestones/05-provider-validation.md.
# PROKERALA_CLIENT_ID=
# PROKERALA_CLIENT_SECRET=
# FREE_ASTROLOGY_API_KEY=

# --- Geocoding (birth location -> lat/lon) ---
# OpenCage free tier: https://opencagedata.com
OPENCAGE_API_KEY=

# --- Matching ---
# Free users see a more selective deck; Stardust Plus subscribers see a
# wider pool (lower bar) - part of the "extra possibilities" paid perk.
MIN_COMPATIBILITY_SCORE_FREE=65
MIN_COMPATIBILITY_SCORE_PAID=50
# Free users can make this many swipes per rolling 24h; Plus is unlimited.
FREE_DAILY_SWIPE_LIMIT=20
# How long a Plus "boost" keeps a profile prioritized in other users' decks.
BOOST_DURATION_HOURS=3

# --- Web Push notifications (new matches / messages) ---
# Unlike OAuth, this needs no external account - just a keypair you
# generate yourself, e.g.:
#   pnpm --filter @stardust/api exec node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY must also be set as NEXT_PUBLIC_VAPID_PUBLIC_KEY in
# apps/web/.env.local (same value - it's the public half of the keypair,
# safe to expose to the browser). Omitted entirely = notifications feature
# just doesn't appear in the UI, same graceful-degradation pattern as
# everything else optional in this file.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:you@example.com"

# --- Stardust Plus billing (Stripe) ---
# Optional - omitted means the billing routes/webhook are unconfigured and
# "Plus" just isn't purchasable yet (/plus shows a "coming soon" state),
# same graceful-degradation pattern as OAuth/third-party providers above.
# Stripe Dashboard (test mode) -> Developers -> API keys.
STRIPE_SECRET_KEY=
# Stripe Dashboard -> Developers -> Webhooks -> add endpoint
# {API_PUBLIC_URL}/api/billing/webhook -> signing secret. For local dev, use
# the Stripe CLI instead: `stripe listen --forward-to localhost:4000/api/billing/webhook`
# (it prints a webhook secret for that session).
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard -> Product catalog -> create the single "Stardust Plus"
# recurring price -> copy its Price ID (starts with `price_`).
STRIPE_PRICE_ID=
