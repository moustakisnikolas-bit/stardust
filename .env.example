# --- Database ---
DATABASE_URL="postgresql://stardust:stardust@127.0.0.1:5433/stardust"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_REFRESH_SECRET="change-me-dev-only-too"

# --- Server ---
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# --- Astrology provider selection ---
# Registered provider ids: swiss-ephemeris (default, self-hosted, no key needed)
ASTROLOGY_PROVIDER_DEFAULT="swiss-ephemeris"
# Optional per-country override, JSON map of ISO country code -> provider id.
# Populate once scripts/compare-providers.ts has validated accuracy per region.
# ASTROLOGY_PROVIDER_BY_COUNTRY={"US":"swiss-ephemeris"}

# --- Third-party astrology providers (Phase 4, not required for swiss-ephemeris) ---
# PROKERALA_CLIENT_ID=
# PROKERALA_CLIENT_SECRET=
# FREE_ASTROLOGY_API_KEY=

# --- Geocoding (birth location -> lat/lon) ---
# OpenCage free tier: https://opencagedata.com
OPENCAGE_API_KEY=

# --- Matching ---
MIN_COMPATIBILITY_SCORE=60
